NEXT_PUBLIC_SUPABASE_URL=https://mkthxogkzllahenbrxle.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Restricted inventory_runtime login, never postgres or service_role.
# Copy the host/port from Supabase Connect; URL-encode the password.
DATABASE_URL=postgresql://inventory_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Separate administrative connection for local testing/introspection only.
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Canonical app origin for signup, password recovery, reminder and unsubscribe links.
# Set to the public HTTPS origin when deploying; restart after changing it.
APP_URL=http://localhost:3000

# Subscription reminder email (server-side only).
# RESEND_API is also supported for existing installations.
RESEND_API_KEY=your-resend-api-key
RESEND_TEST_RECIPIENT=your-resend-account-email@example.com
REMINDER_FROM="Inventory Reminders <onboarding@resend.dev>"
# Generate independent random secrets, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REMINDER_SIGNING_SECRET=your-random-signing-secret
REMINDER_WORKER_SECRET=your-different-random-worker-secret
# Configure in Resend when a publicly reachable webhook URL is available.
# RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret
# REMINDER_EMAIL_DISABLED=1
